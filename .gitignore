# The match data is licensed for the competition only and must never be committed, and neither must anything
# derived from it frame by frame (caches, per-frame outputs, review notes).

# -- match data --------------------------------------------------------------------------------
data/*
!data/README.md
*.mp4
*.gzip
*.pl3container

# -- ground truth other than the organisers' public 5 minutes ----------------------------------
*_possession_gt.csv
*_possession_gt_meta.json
*_possession_gt_reference.csv
possession_by_frame.pkl

# -- per-frame outputs -------------------------------------------------------------------------
# A label file for the whole match is derived data. The organisers' baselines are the one exception.
evaluation/results/*.csv
!evaluation/results/baseline_*.csv
evaluation/reports/
evaluation/scoreboard.csv
outputs/
cache/
validation/
docs/runlog.jsonl

# -- external datasets and training scratch ----------------------------------------------------
work_data/
members_kit/
*.npy
*.npz
*.partial

# -- editors and build artifacts ---------------------------------------------------------------
.idea/
.vscode/
.claude/
__pycache__/
.pytest_cache/
*.py[cod]
.venv/
venv/
env/
.DS_Store

# -- material of the team repository that is not published --------------------------------------
# The public tree is exported from an allowlist (scripts/public_export.py); these lines keep the same files
# out if anyone later copies them in by hand.
docs/*
!docs/figures/
evidence/
validation/
wira_improve/
TEAM_GUIDE.md
/external/
evaluation/visualizations/
.venv*/

# -- the submission file: uploaded through the form and regenerated by run.py, never committed ---------
/L2Kotak.csv
/submission/
